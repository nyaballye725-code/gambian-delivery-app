# ---------------------------------------------------------------------------
# Jotna environment configuration
# Copy to `.env.local` and adjust. Every value is optional for local dev.
# ---------------------------------------------------------------------------

# Postgres connection string. Leave empty to use the embedded PGlite database
# stored in .data/pglite (zero setup, perfect for previews).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Signing secret for session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Demo mode: one-click entry into the seeded demo accounts (default: on).
# Set to false for a real deployment.
# DEMO_MODE=false

# Where the embedded PGlite database lives when DATABASE_URL is unset.
# PGLITE_DATA_DIR=.data/pglite

# Maximum number of pooled Postgres connections (default 10).
# DATABASE_POOL_SIZE=10
